NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secrets - never expose these to the browser or commit real values.
# The service-role key (Supabase > Project Settings > API) is used by the daily
# membership-expiry job; CRON_SECRET is any long random string you make up, and
# that job rejects requests that don't send it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=a-long-random-string

# The gym's own name, shown on receipts, reminder messages, the sidebar, the
# login page and the browser tab. Optional (defaults to "GymDesk"). It's baked
# in at build time, so redeploy after changing it.
NEXT_PUBLIC_GYM_NAME=Your Gym Name
